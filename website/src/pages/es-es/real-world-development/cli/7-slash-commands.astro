---
const target = `${import.meta.env.BASE_URL}es-es/real-world-development/cli/9-cli-power-tools/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="es-ES" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>Redirección a Funciones avanzadas de la CLI</title>
  </head>
  <body>
    <a href={target}>Este ejercicio ha cambiado de ubicación. Continúa con las funciones avanzadas de Copilot CLI.</a>
  </body>
</html>
